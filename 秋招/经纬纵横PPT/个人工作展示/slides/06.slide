<Slide style={{ width: 1280, height: 720, background: '#F6F7F9', padding: 60, fontFamily: 'Microsoft YaHei', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', width: '100%' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#12161F', lineHeight: 1.2 }}>两段实习：AI、业务、性能</Text>
        <Text style={{ fontSize: 14, color: '#98A2B3', letterSpacing: 2, lineHeight: 1.5 }}>02 / 实习经历</Text>
    </Box>
    <Box style={{ height: 1, width: '100%', background: '#DCE0E6', marginTop: 16 }} />

    <Box style={{ flexDirection: 'row', width: '100%', gap: 40, marginTop: 24 }}>
        <Box style={{ width: 660, borderTop: '2px solid #1B3C6E', paddingTop: 14, flexDirection: 'column' }}>
            <Text style={{ fontSize: 14, color: '#7B8697' }}>2025.12 – 2026.08</Text>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14, marginTop: 10 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#12161F' }}>快手</Text>
                <Text style={{ fontSize: 17, color: '#3D4756' }}>企业应用网关 · 后台与网关开发</Text>
            </Box>
        </Box>

        <Box style={{ width: 460, borderTop: '2px solid #C9CFD8', paddingTop: 14, flexDirection: 'column' }}>
            <Text style={{ fontSize: 14, color: '#7B8697' }}>2025.05 – 2025.11</Text>
            <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 14, marginTop: 10 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#12161F' }}>合合信息</Text>
                <Text style={{ fontSize: 17, color: '#3D4756' }}>安全运营开发</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', paddingTop: 12, paddingBottom: 12, borderTop: '1px solid #1B3C6E', borderBottom: '1px solid #DCE0E6', width: '100%', marginTop: 32 }}>
        <Text style={{ fontSize: 14, color: '#98A2B3', width: 170 }}>方向</Text>
        <Text style={{ fontSize: 14, color: '#98A2B3', width: 520 }}>快手 · 企业应用网关</Text>
        <Text style={{ fontSize: 14, color: '#98A2B3', flex: 1 }}>合合信息 · 安全运营</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 96, borderBottom: '1px solid #DCE0E6', width: '100%' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#12161F', width: 170, lineHeight: 1.4 }}>AI 建设</Text>
        <Text style={{ fontSize: 17, color: '#3D4756', width: 520, lineHeight: 1.55 }}>AI 评审与单测生成接入研发流水线，合并前自动触发，使用数据上看板</Text>
        <Text style={{ fontSize: 17, color: '#3D4756', flex: 1, lineHeight: 1.55 }}>Prompt 约束模型结构化输出，生成标准化法规解读报告</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 120, borderBottom: '1px solid #DCE0E6', width: '100%' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#12161F', width: 170, lineHeight: 1.4 }}>业务逻辑</Text>
        <Text style={{ fontSize: 17, color: '#3D4756', width: 520, lineHeight: 1.55 }}>Agent 身份识别与维度限流；离职权限事件驱动回收；超级管理员权限流程化</Text>
        <Text style={{ fontSize: 17, color: '#3D4756', flex: 1, lineHeight: 1.55 }}>告警聚合防消息风暴；隐私政策短链；域名与授权申请接入审批</Text>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 120, borderBottom: '1px solid #DCE0E6', width: '100%' }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#E1582F', width: 170, lineHeight: 1.4 }}>性能与一致性</Text>
        <Text style={{ fontSize: 17, color: '#3D4756', width: 520, lineHeight: 1.55 }}>前缀树路由（O(N)→O(K)）、批量打点、配置加载重构</Text>
        <Text style={{ fontSize: 17, color: '#3D4756', flex: 1, lineHeight: 1.55 }}>延迟双删降脏读、分布式锁削峰、慢查询治理</Text>
    </Box>

    <Box style={{ flex: 1 }} />

    <Box style={{ flexDirection: 'row', width: '100%' }}>
        <Box style={{ width: 2, background: '#E1582F' }} />
        <Text style={{ flex: 1, fontSize: 17, color: '#12161F', lineHeight: 1.6, paddingLeft: 20 }}>
            两段都在做同一件事的不同侧面：让一个别人依赖的系统，不出错、不变慢、也不被绕过。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 30, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#A6AEBB' }}>韩雪刚 · 个人工作展示</Text>
        <Text style={{ fontSize: 14, color: '#A6AEBB' }}>06 / 21</Text>
    </Box>

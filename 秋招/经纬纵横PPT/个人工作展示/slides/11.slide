<Slide style={{ width: 1280, height: 720, background: '#F6F7F9', padding: 60, fontFamily: 'Microsoft YaHei', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', width: '100%' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#12161F', lineHeight: 1.2 }}>权限治理：把「谁能访问什么」收进流程</Text>
        <Text style={{ fontSize: 14, color: '#98A2B3', letterSpacing: 2, lineHeight: 1.5 }}>03 / 产品与项目</Text>
    </Box>
    <Box style={{ height: 1, width: '100%', background: '#DCE0E6', marginTop: 16 }} />

    <Text style={{ fontSize: 17, color: '#3D4756', lineHeight: 1.55, marginTop: 20 }}>
        原来的三个缺口：审计链路会断，离职回收靠审批节奏，高危权限没有流程约束，智能体则完全没有身份。
    </Text>

    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1B3C6E', marginTop: 24 }}>一条线：人工账号的生命周期</Text>

    <Box style={{ flexDirection: 'row', width: '100%', gap: 16, marginTop: 18 }}>
        <Box style={{ width: 260, flexDirection: 'column' }}>
            <Box style={{ width: 56, height: 3, background: '#1B3C6E' }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#12161F', lineHeight: 1.3, marginTop: 18 }}>接入</Text>
            <Text style={{ fontSize: 17, color: '#3D4756', lineHeight: 1.5, marginTop: 12 }}>外部账号纳入授权范围，不再有无主账号绕过控制。</Text>
        </Box>

        <Box style={{ width: 300, flexDirection: 'column' }}>
            <Box style={{ width: 56, height: 3, background: '#1B3C6E' }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#12161F', lineHeight: 1.3, marginTop: 18 }}>申请</Text>
            <Text style={{ fontSize: 17, color: '#3D4756', lineHeight: 1.5, marginTop: 12 }}>域名管理员走审批加消息队列，从申请到授权全链路可追溯。</Text>
        </Box>

        <Box style={{ width: 300, flexDirection: 'column' }}>
            <Box style={{ width: 56, height: 3, background: '#1B3C6E' }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#12161F', lineHeight: 1.3, marginTop: 18 }}>高危操作</Text>
            <Text style={{ fontSize: 17, color: '#3D4756', lineHeight: 1.5, marginTop: 12 }}>超级管理员从手动改库收敛到控制台，带过期时间与白名单。</Text>
        </Box>

        <Box style={{ width: 252, flexDirection: 'column' }}>
            <Box style={{ width: 56, height: 3, background: '#E1582F' }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#12161F', lineHeight: 1.3, marginTop: 18 }}>离职</Text>
            <Text style={{ fontSize: 17, color: '#3D4756', lineHeight: 1.5, marginTop: 12 }}>从审批驱动改为异动事件驱动，分发到各模块自动回收。</Text>
        </Box>
    </Box>

    <Box style={{ height: 1, width: '100%', background: '#DCE0E6', marginTop: 34 }} />

    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#E1582F', marginTop: 22 }}>另一条线：Agent 的访问边界</Text>

    <Box style={{ flexDirection: 'column', width: '100%', marginTop: 12 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', paddingTop: 12, paddingBottom: 12, borderBottom: '1px solid #DCE0E6' }}>
            <Text style={{ fontSize: 14, color: '#98A2B3', width: 130 }}>身份认证</Text>
            <Text style={{ fontSize: 17, color: '#12161F', flex: 1 }}>Agent 需要有独立身份，不复用人工账号，避免权限被「借用」</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', paddingTop: 12, paddingBottom: 12, borderBottom: '1px solid #DCE0E6' }}>
            <Text style={{ fontSize: 14, color: '#98A2B3', width: 130 }}>路由权限</Text>
            <Text style={{ fontSize: 17, color: '#12161F', flex: 1 }}>按域名配置 Agent 可访问的范围，越界请求直接拒绝</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', paddingTop: 12, paddingBottom: 12, borderBottom: '1px solid #DCE0E6' }}>
            <Text style={{ fontSize: 14, color: '#98A2B3', width: 130 }}>维度限流</Text>
            <Text style={{ fontSize: 17, color: '#12161F', flex: 1 }}>按 Agent 维度单独限流，单个智能体打不满整条网关</Text>
        </Box>
    </Box>

    <Box style={{ flex: 1 }} />

    <Box style={{ flexDirection: 'row', width: '100%' }}>
        <Box style={{ width: 2, background: '#1B3C6E' }} />
        <Text style={{ flex: 1, fontSize: 17, color: '#12161F', lineHeight: 1.6, paddingLeft: 20 }}>
            人工账号管「生命周期」，Agent 管「访问边界」——两条线合起来，才是完整的访问控制。
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 30, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#A6AEBB' }}>韩雪刚 · 个人工作展示</Text>
        <Text style={{ fontSize: 14, color: '#A6AEBB' }}>11 / 21</Text>
    </Box>
</Slide>

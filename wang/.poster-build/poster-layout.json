{"id":"sh/1gfudw3m","kind":"textbox","name":"Formulation copy","position":{"left":66,"top":1417,"width":1454,"height":240},"text":"FPCM: PEG1000/PVA with CNF-COOH reinforcement and MWCNTs-COOH conductive pathways.\nTC-RGY20: electrospun PVDF with 20 wt% thermochromic microcapsules (22, 28 and 33 °C).","style":{"fontSize":44,"typeface":"Times New Roman","color":"#111111","alignment":"left"},"geometry":"rect","lineWidth":0},

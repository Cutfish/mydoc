{"id":"sh/dcfu9c3q","kind":"textbox","name":"Introduction copy","position":{"left":66,"top":903,"width":1454,"height":248},"text":"Integrate visible temperature indication, reversible optical switching and latent heat storage in one flexible film.\nA layered structure separates the dark conductive storage layer from the thermochromic optical surface.","style":{"fontSize":46,"typeface":"Times New Roman","color":"#111111","alignment":"left"},"geometry":"rect","lineWidth":0},
